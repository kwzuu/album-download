#!/usr/bin/env python3
"""Find MusicBrainz releases for an album, or print one release's tracklist.

  mb-releases ARTIST ALBUM [--limit N]   candidate releases + "already in library?" check
  mb-releases --tracks MBID              tracklist; also caches it for album-check

Prefer the standard digital/CD release: deluxe/box editions with inflated track
counts are rarely on Soulseek.
"""
import argparse
import json
import os
import subprocess
import sys
import time
import urllib.parse
import urllib.request

UA = "album-download/1.0 ( https://github.com/kwzuu/album-download )"
API = "https://musicbrainz.org/ws/2"
CACHE = os.path.expanduser("~/.cache/album-download")


def get(path, **params):
    params["fmt"] = "json"
    url = f"{API}/{path}?{urllib.parse.urlencode(params)}"
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    for attempt in range(4):
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.load(r)
        except urllib.error.HTTPError as e:
            if e.code in (503, 429) and attempt < 3:  # MB rate limit: 1 req/s
                time.sleep(2 + attempt * 2)
                continue
            raise


def lucene_quote(s):
    return '"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'


def search(artist, album, limit):
    q = f"release:{lucene_quote(album)} AND artist:{lucene_quote(artist)}"
    data = get("release/", query=q, limit=limit)
    rels = data.get("releases", [])
    if not rels:
        print("no releases found", file=sys.stderr)
        return 1
    print(f"{'sc':>3}  {'mbid':36}  {'date':10} {'cc':2}  {'status':8} {'type':16} tracks  media | title")
    for r in rels:
        rg = r.get("release-group", {})
        kind = rg.get("primary-type") or "?"
        sec = rg.get("secondary-types") or []
        if sec:
            kind += "+" + "+".join(sec)
        media = r.get("media", [])
        fmt = ", ".join(f"{m.get('format') or '?'}x{m.get('track-count', '?')}" for m in media)
        total = sum(m.get("track-count", 0) or 0 for m in media)
        title = r["title"]
        if r.get("disambiguation"):
            title += f" ({r['disambiguation']})"
        print(f"{r.get('score', 0):>3}  {r['id']}  {(r.get('date') or '?'):10} {(r.get('country') or '??'):2}  "
              f"{(r.get('status') or '?')[:8]:8} {kind[:16]:16} {total:>6}  {fmt} | {title}")
    # library check, by the first result's credited artist when it looks right
    credit = "".join(c.get("name", "") + c.get("joinphrase", "") for c in rels[0].get("artist-credit", [])) or artist
    print(f"\nin library as albumartist:{credit!r}:")
    out = subprocess.run([sys.executable, "-m", "beets", "ls", "-a", f"albumartist:{credit}"],
                         capture_output=True, text=True).stdout.strip()
    print("  " + (out.replace("\n", "\n  ") if out else "(nothing)"))
    return 0


def tracks(mbid):
    data = get(f"release/{mbid}", inc="recordings+artist-credits+release-groups")
    os.makedirs(CACHE, exist_ok=True)
    with open(os.path.join(CACHE, f"{mbid}.json"), "w") as f:
        json.dump(data, f)
    credit = "".join(c.get("name", "") + c.get("joinphrase", "") for c in data.get("artist-credit", []))
    print(f"{credit} - {data['title']} ({data.get('date') or '?'}, {data.get('country') or '??'})")
    n = 0
    for m in data.get("media", []):
        print(f"-- disc {m.get('position')} {m.get('format') or ''}")
        for t in m.get("tracks", []):
            n += 1
            ms = t.get("length") or 0
            print(f"  {t.get('number', '?'):>3}. {t['title']}  [{ms // 60000}:{ms // 1000 % 60:02d}]")
    print(f"total tracks: {n}")
    return 0


def main():
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("artist", nargs="?")
    ap.add_argument("album", nargs="?")
    ap.add_argument("--tracks", metavar="MBID")
    ap.add_argument("--limit", type=int, default=20)
    a = ap.parse_args()
    if a.tracks:
        return tracks(a.tracks)
    if not (a.artist and a.album):
        ap.error("need ARTIST ALBUM, or --tracks MBID")
    return search(a.artist, a.album, a.limit)


if __name__ == "__main__":
    sys.stdout.reconfigure(line_buffering=True)  # keep our lines in order with subprocess output
    sys.exit(main())
